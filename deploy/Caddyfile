{
	email {$INTERARCADE_TLS_EMAIL}
}

{$INTERARCADE_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age={$INTERARCADE_HSTS_MAX_AGE}"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}
	reverse_proxy api:5000 {
		header_up X-InterArcade-Client-IP {remote_host}
	}
}
