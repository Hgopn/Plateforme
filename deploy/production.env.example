# Copy to ../.env.production with mode 600. Never commit real values.
INTERARCADE_DOMAIN=interarcade.example.com
INTERARCADE_PUBLIC_IP=203.0.113.10
INTERARCADE_TLS_EMAIL=admin@interarcade.example.com
INTERARCADE_SECRET_KEY=replace-with-random-hex
INTERARCADE_SESSION_SECRET=replace-with-independent-random-hex
INTERARCADE_ADMIN_TOKEN=replace-with-independent-random-hex
INTERARCADE_INTERNAL_EVENT_TOKEN=replace-with-independent-random-hex
INTERARCADE_OBSERVER_TOKEN=replace-with-independent-random-hex
INTERARCADE_DB_PASSWORD=replace-with-random-hex
INTERARCADE_ALLOWED_ORIGINS=https://interarcade.example.com
INTERARCADE_REQUIRE_WORKER_HEARTBEAT=true
INTERARCADE_CREATOR_SESSION_LEASE_SECONDS=120
INTERARCADE_LOG_LEVEL=INFO
INTERARCADE_GIT_VERSION=release-version
EULER_API_KEY=
